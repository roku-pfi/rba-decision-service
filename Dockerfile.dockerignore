**/.git
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
**/node_modules
**/dist
**/build
**/.DS_Store
**/.env
**/.cursor
**/reports
**/.mlflow
**/.mplcache
**/data/raw
**/data/subset
**/*.csv
**/*.parquet
**/*.pkl
**/material_sources
**/.idea
**/.vscode
